# Copy this file to .env.local (recommended) or .env in this folder, then restart: npm run dev
#
# Supabase — Project Settings → API → Project URL + anon public key
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenRouter — same key as backend/src/main/resources/application.properties (careerpilot.openai.api-key)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key
VITE_OPENROUTER_MODEL=gpt-oss-120b
